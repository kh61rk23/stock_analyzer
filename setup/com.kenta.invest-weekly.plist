<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 審議→成績→デビル校正の週次自動実行（毎週日曜21:00） -->
<!-- 実行は司令塔シェル run_apps.sh の invest-weekly に委ねる。run_apps.sh が
     リポジトリのパス解決・実在チェック・中央ログ記録を担うため、ここには
     WorkingDirectory を書かない（リポジトリを移すと plist が黙って壊れるため）。
     登録手順（1回だけ）:
     1) cp setup/com.kenta.invest-weekly.plist ~/Library/LaunchAgents/
     2) launchctl load ~/Library/LaunchAgents/com.kenta.invest-weekly.plist
     解除: launchctl unload ~/Library/LaunchAgents/com.kenta.invest-weekly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kenta.invest-weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/<ユーザー名>/Documents/Obsidian_Local/司令塔シェル_動かさない/run_apps.sh</string>
    <string>invest-weekly</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/invest-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/invest-weekly.err</string>
</dict>
</plist>
